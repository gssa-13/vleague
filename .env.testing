APP_NAME="vl League Testing"
APP_ENV=testing
APP_KEY=base64:PLACEHOLDER_WILL_BE_GENERATED
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Tests must NEVER connect to real PostgreSQL or MySQL containers
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Legacy MySQL — disabled in tests (no real connection allowed)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=olimpus
LEGACY_DB_USERNAME=olimpus_user
LEGACY_DB_PASSWORD=secret

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

BCRYPT_ROUNDS=4
